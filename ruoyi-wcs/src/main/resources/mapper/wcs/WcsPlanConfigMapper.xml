<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.wcs.mapper.WcsPlanConfigMapper">
    
    <resultMap type="WcsPlanConfig" id="WcsPlanConfigResult">
        <result property="id"    column="id"    />
        <result property="planNo"    column="plan_no"    />
        <result property="planDesc"    column="plan_desc"    />
        <result property="planStatus"    column="plan_status"    />
        <result property="logicalAddress"    column="logical_address"    />
        <result property="wcsToPos"    column="wcs_to_pos"    />
        <result property="status"    column="status"    />
        <result property="qty"    column="qty"    />
        <result property="qtyDeal"    column="qty_deal"    />
        <result property="createDate"    column="create_date"    />
        <result property="updateDate"    column="update_date"    />
    </resultMap>

    <sql id="selectWcsPlanConfigVo">
        select id, plan_no, plan_desc, plan_status, logical_address, wcs_to_pos, status, qty, qty_deal, create_date, update_date from wcs_plan_config
    </sql>

    <select id="selectWcsPlanConfigList" parameterType="WcsPlanConfig" resultMap="WcsPlanConfigResult">
        <include refid="selectWcsPlanConfigVo"/>
        <where>  
            <if test="planNo != null  and planNo != ''"> and plan_no = #{planNo}</if>
            <if test="planDesc != null  and planDesc != ''"> and plan_desc = #{planDesc}</if>
            <if test="planStatus != null  and planStatus != ''"> and plan_status = #{planStatus}</if>
            <if test="logicalAddress != null  and logicalAddress != ''"> and logical_address = #{logicalAddress}</if>
            <if test="wcsToPos != null  and wcsToPos != ''"> and wcs_to_pos = #{wcsToPos}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="qty != null "> and qty = #{qty}</if>
            <if test="qtyDeal != null "> and qty_deal = #{qtyDeal}</if>
            <if test="params.beginCreateDate != null and params.beginCreateDate != '' and params.endCreateDate != null and params.endCreateDate != ''"> and create_date between #{params.beginCreateDate} and #{params.endCreateDate}</if>
            <if test="params.beginUpdateDate != null and params.beginUpdateDate != '' and params.endUpdateDate != null and params.endUpdateDate != ''"> and update_date between #{params.beginUpdateDate} and #{params.endUpdateDate}</if>
        </where>
    </select>
    
    <select id="selectWcsPlanConfigById" parameterType="Long" resultMap="WcsPlanConfigResult">
        <include refid="selectWcsPlanConfigVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertWcsPlanConfig" parameterType="WcsPlanConfig">
        insert into wcs_plan_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="planNo != null">plan_no,</if>
            <if test="planDesc != null">plan_desc,</if>
            <if test="planStatus != null">plan_status,</if>
            <if test="logicalAddress != null">logical_address,</if>
            <if test="wcsToPos != null">wcs_to_pos,</if>
            <if test="status != null">status,</if>
            <if test="qty != null">qty,</if>
            <if test="qtyDeal != null">qty_deal,</if>
            <if test="createDate != null">create_date,</if>
            <if test="updateDate != null">update_date,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="planNo != null">#{planNo},</if>
            <if test="planDesc != null">#{planDesc},</if>
            <if test="planStatus != null">#{planStatus},</if>
            <if test="logicalAddress != null">#{logicalAddress},</if>
            <if test="wcsToPos != null">#{wcsToPos},</if>
            <if test="status != null">#{status},</if>
            <if test="qty != null">#{qty},</if>
            <if test="qtyDeal != null">#{qtyDeal},</if>
            <if test="createDate != null">#{createDate},</if>
            <if test="updateDate != null">#{updateDate},</if>
         </trim>
    </insert>

    <update id="updateWcsPlanConfig" parameterType="WcsPlanConfig">
        update wcs_plan_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="planNo != null">plan_no = #{planNo},</if>
            <if test="planDesc != null">plan_desc = #{planDesc},</if>
            <if test="planStatus != null">plan_status = #{planStatus},</if>
            <if test="logicalAddress != null">logical_address = #{logicalAddress},</if>
            <if test="wcsToPos != null">wcs_to_pos = #{wcsToPos},</if>
            <if test="status != null">status = #{status},</if>
            <if test="qty != null">qty = #{qty},</if>
            <if test="qtyDeal != null">qty_deal = #{qtyDeal},</if>
            <if test="createDate != null">create_date = #{createDate},</if>
            <if test="updateDate != null">update_date = #{updateDate},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWcsPlanConfigById" parameterType="Long">
        delete from wcs_plan_config where id = #{id}
    </delete>

    <delete id="deleteWcsPlanConfigByIds" parameterType="String">
        delete from wcs_plan_config where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>